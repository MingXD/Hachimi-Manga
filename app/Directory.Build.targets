<Project>
  <!-- 仓库级构建注入：vendor 中可选的 pdfium.dll 自动复制到每个项目输出目录（bin/publish）。
       vendor/ 不入库（.gitignore）；本文件保证 dll 缺失时构建照常（PDF 功能届时提示不可用）。 -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\vendor\pdfium\win-x64\pdfium.dll')">
    <None Include="$(MSBuildThisFileDirectory)..\vendor\pdfium\win-x64\pdfium.dll"
          Link="pdfium.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
