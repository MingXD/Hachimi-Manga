<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MangaAgent.App.ViewModels"
        xmlns:core="using:MangaAgent.Core.Library"
        x:Class="MangaAgent.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1200" Height="800"
        Title="Hachimi Manga — 漫画阅读器">

  <DockPanel>
    <!-- 顶栏 -->
    <!-- 顶栏：Grid 单格叠加层 —— 声明顺序即层级（后声明在上）：
         最底=状态文本(右对齐,右Margin 304 避开搜索框) → 中=搜索框(右280) → 最顶=标题+按钮(左StackPanel,不压缩) -->
    <Border DockPanel.Dock="Top" Padding="10,8" Background="#1C1C24">
      <Grid>
        <!-- 最底层：状态文本（最先被盖住） -->
        <TextBlock Text="{Binding StatusText}" Foreground="#B0B0B0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,304,0"/>
        <!-- 中层：搜索框（右 280） -->
        <TextBox Width="280" PlaceholderText="搜索标题 / 系列…" Text="{Binding SearchText}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <!-- 最顶层：标题 + 按钮（左 StackPanel，窗口变窄不压缩 → 自然盖住搜索框/状态文本） -->
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Left">
          <TextBlock Text="Hachimi Manga" Foreground="#E8E8E8" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0"/>
          <Button Content="＋ 添加资料库" Command="{Binding AddLibraryCommand}"/>
          <Button Content="重新扫描" Command="{Binding RescanCommand}" IsEnabled="{Binding !IsScanning}"/>
          <Button Content="{Binding GalleryModeText}" Command="{Binding CycleGalleryModeCommand}" ToolTip.Tip="切换展示（大图/中图/小图/详情）"/>
        </StackPanel>
      </Grid>
    </Border>
    <!-- 侧边栏 + 可拖动分隔条 + 内容区（Grid 三列：0=侧栏 1=分隔条 2=内容） -->
    <Grid ColumnDefinitions="240,4,*">
      <!-- 侧边栏：文件夹层级树 -->
      <Border Grid.Column="0" Background="#16161C">
        <DockPanel>
          <!-- 资料库：标签 + 下拉（固定宽度=侧边栏剩余，随名称不变）+ 清空按钮，与文件夹宽度一致 -->
          <DockPanel DockPanel.Dock="Top" Margin="12,10,12,8">
            <Button DockPanel.Dock="Right" Content="清空" Command="{Binding ClearLibrariesCommand}" FontSize="11" Padding="6,2" Margin="6,0,0,0" ToolTip.Tip="清空所有资料库"/>
            <TextBlock DockPanel.Dock="Left" Text="资料库" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
            <ComboBox ItemsSource="{Binding Libraries}" SelectedItem="{Binding SelectedLibrary}"
                      Background="#1E1E26" Foreground="#E8E8E8" HorizontalAlignment="Stretch"
                      PlaceholderText="选择资料库…" MaxDropDownHeight="320">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LibraryItemViewModel">
                  <TextBlock Text="{Binding Name}" Foreground="#E8E8E8" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="文件夹" Foreground="#888888" Margin="12,10,12,6" FontSize="12"/>
          <TreeView ItemsSource="{Binding FolderTree}" SelectedItem="{Binding SelectedFolder}" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Hidden">
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}">
                <TextBlock Text="{Binding Name}" Foreground="#E8E8E8" Margin="4,3" MaxWidth="196" TextTrimming="CharacterEllipsis"/>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="4" Background="#2A2A34" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
      <!-- 内容区：面包屑 + 目录浏览器 -->
      <DockPanel Grid.Column="2">
        <Border DockPanel.Dock="Top" Padding="10,5" Background="#14141A">
          <DockPanel>
            <Button DockPanel.Dock="Left" Content="⬆ 上级" Command="{Binding GoUpCommand}" Margin="0,0,8,0"/>
            <ItemsControl ItemsSource="{Binding Breadcrumbs}" Margin="8,0,0,0" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:FolderNode">
                  <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding Name}" Click="OnBreadcrumbClick" Tag="{Binding}" Background="Transparent" Padding="2,0" FontSize="12"/>
                    <TextBlock Text="/" Foreground="#666666" Margin="2,0"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>
        <Border Background="#101014">
          <Grid>
          <ScrollViewer x:Name="CoverScroller" Margin="14" ScrollChanged="OnCoverScrollChanged" IsVisible="{Binding !IsDetailView}">
            <ListBox x:Name="BooksList" ItemsSource="{Binding FolderEntries}" IsVisible="{Binding !IsDetailView}"
                     Background="Transparent" HorizontalAlignment="Left"
                     DoubleTapped="OnBookDoubleTapped">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemWidth="{Binding GalleryItemWidth}" ItemHeight="{Binding GalleryItemHeight}"/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FolderEntryItemViewModel">
                  <Border Width="{Binding CardWidth}" Height="{Binding CardHeight}" Background="#1E1E26" CornerRadius="6" BorderBrush="#333333" BorderThickness="1" ClipToBounds="True" Margin="4"
                          ToolTip.Tip="{Binding DisplayName}">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="打开" Command="{Binding OpenCommand}"/>
                        <Separator/>
                        <MenuItem Header="复制到…" Command="{Binding CopyToCommand}"/>
                        <MenuItem Header="移动到…" Command="{Binding MoveToCommand}"/>
                        <Separator/>
                        <MenuItem Header="重命名" Command="{Binding RenameCommand}"/>
                        <MenuItem Header="删除（回收站）" Command="{Binding DeleteCommand}"/>
                        <Separator/>
                        <MenuItem Header="在资源管理器中显示" Command="{Binding ShowInExplorerCommand}"/>
                        <MenuItem Header="属性" Command="{Binding PropertiesCommand}"/>
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                      <!-- 卡片模式（大/中/小）：文件夹图标 or 封面 + 文本（尺寸/字体随模式注入） -->
                      <StackPanel Margin="6" VerticalAlignment="Center" IsVisible="{Binding !IsDetail}">
                        <StackPanel VerticalAlignment="Center" IsVisible="{Binding IsFolder}">
                          <TextBlock Text="📁" FontSize="64" HorizontalAlignment="Center" Foreground="#D8A24A"/>
                          <TextBlock Text="{Binding DisplayName}" Foreground="#E8E8E8" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="{Binding TitleFontSize}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                          <TextBlock Text="{Binding Subtitle}" Foreground="#888888" FontSize="{Binding SubtitleFontSize}" HorizontalAlignment="Center" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding StatsLine2}" Foreground="#888888" FontSize="{Binding SubtitleFontSize}" HorizontalAlignment="Center" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel IsVisible="{Binding !IsFolder}">
                          <Border Background="#2A2A34" CornerRadius="4" Width="{Binding CoverWidth}" Height="{Binding CoverHeight}" ClipToBounds="True" HorizontalAlignment="Center">
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Width="{Binding CoverWidth}" Height="{Binding CoverHeight}"/>
                          </Border>
                          <TextBlock Text="{Binding DisplayName}" Foreground="#E8E8E8" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="{Binding TitleFontSize}" Margin="0,6,0,0"/>
                          <TextBlock Text="{Binding Subtitle}" Foreground="#888888" FontSize="{Binding SubtitleFontSize}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </StackPanel>
                      <!-- 详情模式（行式：图标 + 伸缩标题 + 贴右两行统计，无图片） -->
                      <Grid IsVisible="{Binding IsDetail}" Margin="10,0" VerticalAlignment="Center" ColumnDefinitions="34,*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding IconText}" FontSize="20" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="#E8E8E8" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayName}" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding SubtitleOneLine}" Foreground="#888888" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SubtitleOneLine}" Margin="16,0,0,0" HorizontalAlignment="Right"/>
                    </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <!-- 详情模式：Windows 文件管理器"详细信息"视图 —— 行占满内容区宽，随窗口伸缩 -->
            <!-- 层级：标题先声明(下层, NoWrap 延伸) → 副标题后声明(上层, 贴右带背景盖住标题) -->
            <!-- 窗口过窄：行 MinWidth=440 不再变短，应用窗口右缘裁剪（ScrollViewer 水平不滚动） -->
          </ScrollViewer>
            <ListBox x:Name="DetailList" IsVisible="{Binding IsDetailView}" ItemsSource="{Binding FolderEntries}" Margin="14" Padding="0,0,12,0"
                     Background="Transparent" DoubleTapped="OnBookDoubleTapped">
              <ListBox.Styles>
                <Style Selector="TextBlock.subtitleCover">
                  <Setter Property="Background" Value="#1E1E26"/>
                </Style>
                <Style Selector="Border.detailRow">
                  <Setter Property="Background" Value="#1E1E26"/>
                  <Setter Property="BorderBrush" Value="#333333"/>
                </Style>
                <Style Selector="Border.detailRow:pointerover">
                  <Setter Property="Background" Value="#2E2E38"/>
                  <Setter Property="BorderBrush" Value="#5A5A6A"/>
                </Style>
                <Style Selector="Border.detailRow:pointerover TextBlock.subtitleCover">
                  <Setter Property="Background" Value="#2E2E38"/>
                </Style>
              </ListBox.Styles>
              <ListBox.ItemContainerTheme>
                <ControlTheme TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="Margin" Value="0,1"/>
                </ControlTheme>
              </ListBox.ItemContainerTheme>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FolderEntryItemViewModel">
                  <Border Classes="detailRow" Height="32" MinWidth="440" Margin="0,1" CornerRadius="4"
                          BorderBrush="#333333" BorderThickness="1" ClipToBounds="True" ToolTip.Tip="{Binding DisplayName}">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="打开" Command="{Binding OpenCommand}"/>
                        <Separator/>
                        <MenuItem Header="复制到…" Command="{Binding CopyToCommand}"/>
                        <MenuItem Header="移动到…" Command="{Binding MoveToCommand}"/>
                        <Separator/>
                        <MenuItem Header="重命名" Command="{Binding RenameCommand}"/>
                        <MenuItem Header="删除（回收站）" Command="{Binding DeleteCommand}"/>
                        <Separator/>
                        <MenuItem Header="在资源管理器中显示" Command="{Binding ShowInExplorerCommand}"/>
                        <MenuItem Header="属性" Command="{Binding PropertiesCommand}"/>
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid ColumnDefinitions="34,*">
                      <TextBlock Grid.Column="0" Text="{Binding IconText}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                      <Grid Grid.Column="1">
                        <TextBlock Text="{Binding DisplayName}" FontSize="13" Foreground="#E8E8E8" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                        <TextBlock Classes="subtitleCover" Text="{Binding SubtitleOneLine}" FontSize="10" Foreground="#888888" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Padding="10,0,6,0"/>
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
