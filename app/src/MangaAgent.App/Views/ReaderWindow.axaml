<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MangaAgent.App.ViewModels"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:views="using:MangaAgent.App.Views"
        x:Class="MangaAgent.App.Views.ReaderWindow"
        x:DataType="vm:ReaderViewModel"
        Width="1100" Height="800"
        Title="{Binding BookTitle}"
        Background="{Binding BackgroundHex}"
        KeyDown="OnKeyDown">
  <Window.Styles>
    <!-- 工具栏按钮：自定义模板（v1.9.6 根治）—— Border 铺满整个按钮，
         视觉边界 = 命中区域 = hover 高亮完全一致，消除"边缘点击无效/闪烁"。 -->
    <Style Selector="StackPanel.toolbar Button">
      <Setter Property="Background" Value="{Binding ToolbarButtonBg}"/>
      <Setter Property="BorderBrush" Value="{Binding ToolbarButtonBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="Foreground" Value="{Binding ForegroundHex}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinWidth" Value="26"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              RecognizesAccessKey="True"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <!-- hover：整个 Border 变高亮（不再有边缘空洞） -->
    <Style Selector="StackPanel.toolbar Button:pointerover /template/ Border">
      <Setter Property="Background" Value="{Binding ToolbarButtonHover}"/>
      <Setter Property="BorderBrush" Value="{Binding ToolbarButtonBorderHover}"/>
    </Style>
    <Style Selector="StackPanel.toolbar Button:pressed /template/ Border">
      <Setter Property="Background" Value="{Binding ToolbarButtonHover}"/>
    </Style>
    <!-- v4.23：书签按钮选中态 —— 选择器带 StackPanel.toolbar 前缀（特异性高于上面两条），否则被工具栏默认色覆盖；
         文字色由样式提供（按钮上不能再写 Foreground 本地值，本地值优先级最高）。 -->
    <Style Selector="StackPanel.toolbar Button.bookmarkState.on">
      <Setter Property="Background" Value="{Binding BookmarkActiveBg}"/>
      <Setter Property="BorderBrush" Value="{Binding BookmarkActiveBorder}"/>
      <Setter Property="Foreground" Value="{Binding BookmarkActiveForeground}"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="StackPanel.toolbar Button.bookmarkState.on:pointerover /template/ Border">
      <Setter Property="Background" Value="{Binding BookmarkActiveHoverBg}"/>
      <Setter Property="BorderBrush" Value="{Binding BookmarkActiveBorder}"/>
    </Style>
    <!-- v4.23：扁平按钮（预览栏 ▲/▼、书签面板按钮）——自定义模板，避免默认主题在白天 hover 变白 -->
    <Style Selector="Button.panelFlat">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              RecognizesAccessKey="True"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.panelFlat:pointerover">
      <Setter Property="Background" Value="{Binding $parent[Window].((vm:ReaderViewModel)DataContext).PreviewStripPanelHoverBg}"/>
    </Style>
    <Style Selector="Button.panelFlat:pressed">
      <Setter Property="Background" Value="{Binding $parent[Window].((vm:ReaderViewModel)DataContext).PreviewStripPanelHoverBg}"/>
    </Style>
    <!-- 预览栏卡片/页码高亮：当前页 = 2px 主题色边框 + 页码变色（普通边框色也主题化） -->
    <Style Selector="Border.previewCard">
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{Binding $parent[Window].((vm:ReaderViewModel)DataContext).PreviewStripCardBorder}"/>
    </Style>
    <Style Selector="Border.previewCard:pointerover">
      <Setter Property="BorderBrush" Value="{Binding $parent[Window].((vm:ReaderViewModel)DataContext).PreviewStripHighlight}"/>
    </Style>
    <Style Selector="Border.previewCard.current">
      <Setter Property="BorderBrush" Value="{Binding $parent[Window].((vm:ReaderViewModel)DataContext).PreviewStripHighlight}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="TextBlock.previewLabel">
      <Setter Property="Foreground" Value="{Binding $parent[Window].((vm:ReaderViewModel)DataContext).PreviewStripLabel}"/>
    </Style>
    <Style Selector="TextBlock.previewLabel.current">
      <Setter Property="Foreground" Value="{Binding $parent[Window].((vm:ReaderViewModel)DataContext).PreviewStripHighlightText}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Styles>

  <DockPanel>




    <!-- 工具栏 -->
    <Border DockPanel.Dock="Top" Padding="10,6" Background="{Binding ToolbarHex}">
      <StackPanel Orientation="Horizontal" Spacing="6" Classes="toolbar">
        <!-- 设置按钮放最前，与操作按钮以竖线分隔（书名已显示在窗口标题栏，不再占工具栏） -->
        <Button Content="⚙ 设置" Click="OnSettingsClick" ToolTip.Tip="阅读设置（基准/手感/快捷键/使用介绍）" Foreground="{Binding ForegroundHex}" MinWidth="64"/>
        <Border Width="1" Background="{Binding ToolbarSeparator}" Margin="2,2" VerticalAlignment="Stretch"/>
        <Button x:Name="NavPrevButton" Content="◀" Click="OnNavPrevClick" Foreground="{Binding ForegroundHex}"/>
        <Button x:Name="NavNextButton" Content="▶" Click="OnNavNextClick" Foreground="{Binding ForegroundHex}"/>
        <Button Content="{Binding PageText}" Click="OnPageTextClick" ToolTip.Tip="点击跳转到指定页 (G)" Background="Transparent" Foreground="{Binding ForegroundHex}" Padding="6,2" Margin="8,0"/>
        <!-- v3：首页/末页按钮与页码块放在一起（右侧），快捷键 Home/End 见设置-快捷键 -->
        <Button x:Name="GoHomeButton" Content="Home" MinWidth="44" Click="OnGoHomeClick" ToolTip.Tip="首页 (Home)" Foreground="{Binding ForegroundHex}"/>
        <Button x:Name="GoEndButton" Content="End" MinWidth="44" Click="OnGoEndClick" ToolTip.Tip="末页 (End)" Foreground="{Binding ForegroundHex}"/>

        <Button x:Name="ModeButton" Content="{Binding ModeText}" Click="OnModeMenuClick" Foreground="{Binding ForegroundHex}">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="单页" Tag="Single" Click="OnModeMenuItemClick"/>
              <MenuItem Header="双页" Tag="Double" Click="OnModeMenuItemClick"/>
              <MenuItem Header="滚动" Tag="Webtoon" Click="OnModeMenuItemClick"/>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <Button x:Name="PairButton" Content="{Binding PairText}" Command="{Binding TogglePairOffsetCommand}" ToolTip.Tip="双页配对起点（第1张起 / 第2张起）" Foreground="{Binding ForegroundHex}"/>
        <Button x:Name="DirectionButton" Content="{Binding DirectionText}" Click="OnDirectionMenuClick" ToolTip.Tip="阅读方向 (D)" Foreground="{Binding ForegroundHex}">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="右→左" Tag="Rtl" Click="OnDirectionMenuItemClick"/>
              <MenuItem Header="左→右" Tag="Ltr" Click="OnDirectionMenuItemClick"/>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <Button Content="{Binding ThemeText}" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="白天/夜间 (T)" Foreground="{Binding ForegroundHex}"/>
        <!-- v4.1-PDF：裁切模式（仅 PDF 书）—— 开 = 按"位图本身"显示（去纸面留白），关 = 纸面视图（Chrome 样） -->
        <Button x:Name="CropButton" Content="{Binding PdfCropText}" Click="OnCropClick" IsVisible="{Binding IsPdf}"
                ToolTip.Tip="PDF 裁切：只显示位图本身（与图片书观感一致）" Foreground="{Binding ForegroundHex}"/>
        <Button x:Name="ZoomOutButton" Content="−" Click="OnZoomOutClick" ToolTip.Tip="缩小" Foreground="{Binding ForegroundHex}"/>
        <TextBlock Text="{Binding ZoomPercentText}" VerticalAlignment="Center" Foreground="{Binding ForegroundHex}" Margin="2,0" ToolTip.Tip="当前缩放（基准=适应屏幕）"/>
        <Button x:Name="ZoomInButton" Content="＋" Click="OnZoomInClick" ToolTip.Tip="放大" Foreground="{Binding ForegroundHex}"/>
        <Button Content="{Binding FitText}" Command="{Binding CycleFitCommand}" ToolTip.Tip="切换适应模式（宽度/高度/屏幕）" Foreground="{Binding ForegroundHex}"/>
        <Button Content="复位" Click="OnResetZoomClick" ToolTip.Tip="适应宽度" Foreground="{Binding ForegroundHex}"/>
        <Button x:Name="SensitivityButton" Content="缩放速度×1" MinWidth="84" Click="OnSensitivityClick" ToolTip.Tip="滚轮缩放灵敏度（快/中/慢）" Foreground="{Binding ForegroundHex}"/>
        <Button x:Name="WebtoonSpeedButton" Content="滚动速度×1" MinWidth="84" Click="OnWebtoonSpeedClick" ToolTip.Tip="滚动模式滚动速度（快/中/慢）" Foreground="{Binding ForegroundHex}" IsVisible="False"/>
        <!-- v4.22：书签精简 —— 只保留"书签"（当前页开关，选中态高亮）与"书签列表"两个按钮。
             v4.23：书签按钮不再写 Foreground 本地值（否则样式无法在高亮时改文字色）。 -->
        <Button x:Name="BookmarkToggleButton" Content="{Binding BookmarkButtonText}"
                Command="{Binding ToggleBookmarkCommand}"
                Classes="bookmarkState" Classes.on="{Binding IsCurrentPageBookmarked}"
                ToolTip.Tip="当前页加/取消书签 (B)"/>
        <Button Content="{Binding BookmarkSummary}" Command="{Binding ToggleBookmarkPanelCommand}" ToolTip.Tip="书签列表（L）" Foreground="{Binding ForegroundHex}"/>
      </StackPanel>
    </Border>

    <!-- 阅读区：画布模型（视口 + 图片层，Scale/Translate 变换，复刻 Windows 看图器） -->


    <Border x:Name="Viewport" ClipToBounds="True" Focusable="True" Background="{Binding BackgroundHex}"
            SizeChanged="OnViewportSizeChanged"
            PointerWheelChanged="OnPointerWheelChanged"
            PointerPressed="OnViewportPointerPressed"
            PointerMoved="OnViewportPointerMoved"
            PointerReleased="OnViewportPointerReleased"
            DoubleTapped="OnViewportDoubleTapped">
      <Grid>
      <Grid x:Name="PageLayer" HorizontalAlignment="Left" VerticalAlignment="Top">
        <!-- 双页无缝拼接：负间距 -1px 让两图重叠 1px，盖住 GPU 采样/亚像素对齐产生的接缝黑线（小红书式无缝） -->
        <StackPanel x:Name="PagePanel" Orientation="Horizontal" Spacing="-1">
          <Image x:Name="PageImage1" Stretch="Uniform" VerticalAlignment="Top"
                 Source="{Binding Image1}"
                 IsVisible="{Binding Image1, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
          <Image x:Name="PageImage2" Stretch="Uniform" VerticalAlignment="Top"
                 Source="{Binding Image2}"
                 IsVisible="{Binding Image2, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
        </StackPanel>
      </Grid>
        <Border x:Name="PreviewStrip" Width="132" Background="{Binding PreviewStripBg}" IsVisible="False"
                HorizontalAlignment="Right" VerticalAlignment="Stretch"
                PointerMoved="OnPreviewStripPointerMoved" PointerExited="OnPreviewStripPointerExited"
                PointerWheelChanged="OnPreviewStripWheel">
          <Grid RowSpacing="6">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Content="▲" Click="OnPreviewStripPrev" Classes="panelFlat" Foreground="{Binding PreviewStripLabel}" Width="124" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    FontSize="16" Height="32" HorizontalAlignment="Center"/>
            <ItemsControl x:Name="ThumbStrip" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Vertical" Spacing="6"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="views:ReaderWindow+ThumbStripItem">
                  <Button Click="OnThumbStripItemClick" Tag="{Binding}" Background="Transparent" Padding="0" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <!-- 缩略图卡片：占位灰块+居中页码，Image 加载成功后覆盖；当前页高亮边框 -->
                      <Border Classes="previewCard" Classes.current="{Binding IsCurrent}"
                              Background="{Binding $parent[Window].((vm:ReaderViewModel)DataContext).PreviewStripItemBg}" CornerRadius="3" ClipToBounds="True"
                              Width="{Binding CardWidth}" Height="{Binding CardHeight}">
                        <Grid>
                          <TextBlock Text="{Binding PageLabel}" Foreground="{Binding $parent[Window].((vm:ReaderViewModel)DataContext).PreviewStripLabel}" FontSize="16"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <Image Source="{Binding Bitmap}" Stretch="UniformToFill"/>
                        </Grid>
                      </Border>
                      <!-- 页码在卡片右侧（横向 → 不占纵向空间，修复小屏第7张被遮） -->
                      <TextBlock Classes="previewLabel" Classes.current="{Binding IsCurrent}"
                                 Text="{Binding PageLabel}" FontSize="9" VerticalAlignment="Center" Width="22" TextAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Grid.Row="2" Content="▼" Click="OnPreviewStripNext" Classes="panelFlat" Foreground="{Binding PreviewStripLabel}" Width="124" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    FontSize="16" Height="32" HorizontalAlignment="Center"/>
          </Grid>
        </Border>
        <!-- v4.21：书签面板（工具栏"书签（N）"切换；点击条目跳转，右侧 × 删除） -->
        <Border x:Name="BookmarkPanel" Width="248" Background="{Binding PreviewStripBg}"
                IsVisible="{Binding IsBookmarkPanelOpen}"
                HorizontalAlignment="Left" VerticalAlignment="Stretch" Padding="8">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding BookmarkSummary}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{Binding PreviewStripLabel}" Margin="2,2,2,8"/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
              <Button Content="清空书签" Click="OnClearBookmarksClick" FontSize="11" Classes="panelFlat"
                      Foreground="{Binding PreviewStripLabel}"
                      ToolTip.Tip="清空本书全部书签（会先确认）"/>
              <Button Content="关闭" Click="OnBookmarkPanelClose" FontSize="11" Classes="panelFlat"
                      Foreground="{Binding PreviewStripLabel}"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding BookmarkItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BookmarkItemViewModel">
                    <Border Background="{Binding $parent[Window].((vm:ReaderViewModel)DataContext).PreviewStripItemBg}"
                            CornerRadius="3" Margin="0,0,0,6" Padding="6,4">
                      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Stretch">
                        <Button Grid.Column="0" Classes="panelFlat" Padding="4,2"
                                Command="{Binding JumpCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                          <StackPanel>
                            <TextBlock Text="{Binding Label}" Foreground="{Binding $parent[Window].((vm:ReaderViewModel)DataContext).PreviewStripLabel}" FontSize="12"/>
                            <TextBlock Text="{Binding NoteText}" IsVisible="{Binding HasNote}" FontSize="10"
                                       Foreground="{Binding $parent[Window].((vm:ReaderViewModel)DataContext).PreviewStripLabel}"
                                       TextTrimming="CharacterEllipsis" MaxLines="2"/>
                          </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Content="×" Command="{Binding DeleteCommand}" FontSize="12" Classes="panelFlat"
                                MinWidth="26" Padding="8,0" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                Foreground="{Binding $parent[Window].((vm:ReaderViewModel)DataContext).PreviewStripLabel}"
                                ToolTip.Tip="删除该书签"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Border>
  </DockPanel>
</Window>
