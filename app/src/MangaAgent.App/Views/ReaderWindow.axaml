<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MangaAgent.App.ViewModels"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:views="using:MangaAgent.App.Views"
        x:Class="MangaAgent.App.Views.ReaderWindow"
        x:DataType="vm:ReaderViewModel"
        Width="1100" Height="800"
        Title="{Binding BookTitle}"
        Background="{Binding BackgroundHex}"
        KeyDown="OnKeyDown">
  <Window.Styles>
    <!-- 工具栏按钮：自定义模板（v1.9.6 根治）—— Border 铺满整个按钮，
         视觉边界 = 命中区域 = hover 高亮完全一致，消除"边缘点击无效/闪烁"。 -->
    <Style Selector="StackPanel.toolbar Button">
      <Setter Property="Background" Value="{Binding ToolbarButtonBg}"/>
      <Setter Property="BorderBrush" Value="{Binding ToolbarButtonBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="Foreground" Value="{Binding ForegroundHex}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinWidth" Value="26"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              RecognizesAccessKey="True"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <!-- hover：整个 Border 变高亮（不再有边缘空洞） -->
    <Style Selector="StackPanel.toolbar Button:pointerover /template/ Border">
      <Setter Property="Background" Value="{Binding ToolbarButtonHover}"/>
      <Setter Property="BorderBrush" Value="{Binding ToolbarButtonBorderHover}"/>
    </Style>
    <Style Selector="StackPanel.toolbar Button:pressed /template/ Border">
      <Setter Property="Background" Value="{Binding ToolbarButtonHover}"/>
    </Style>
  </Window.Styles>

  <DockPanel>




    <!-- 工具栏 -->
    <Border DockPanel.Dock="Top" Padding="10,6" Background="{Binding ToolbarHex}">
      <StackPanel Orientation="Horizontal" Spacing="6" Classes="toolbar">
        <TextBlock Text="{Binding BookTitle}" FontWeight="Bold" Foreground="{Binding ForegroundHex}"
                   VerticalAlignment="Center" Margin="0,0,18,0" MaxWidth="340" TextTrimming="CharacterEllipsis"/>
        <Button x:Name="NavPrevButton" Content="◀" Click="OnNavPrevClick" Foreground="{Binding ForegroundHex}"/>
        <Button x:Name="NavNextButton" Content="▶" Click="OnNavNextClick" Foreground="{Binding ForegroundHex}"/>
        <Button Content="{Binding PageText}" Click="OnPageTextClick" ToolTip.Tip="点击跳转到指定页 (G)" Background="Transparent" Foreground="{Binding ForegroundHex}" Padding="6,2" Margin="8,0"/>

        <Button x:Name="ModeButton" Content="{Binding ModeText}" Click="OnModeMenuClick" Foreground="{Binding ForegroundHex}">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="单页" Tag="Single" Click="OnModeMenuItemClick"/>
              <MenuItem Header="双页" Tag="Double" Click="OnModeMenuItemClick"/>
              <MenuItem Header="滚动" Tag="Webtoon" Click="OnModeMenuItemClick"/>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <Button x:Name="PairButton" Content="{Binding PairText}" Command="{Binding TogglePairOffsetCommand}" ToolTip.Tip="双页配对起点（第1张起 / 第2张起）" Foreground="{Binding ForegroundHex}"/>
        <Button x:Name="DirectionButton" Content="{Binding DirectionText}" Click="OnDirectionMenuClick" ToolTip.Tip="阅读方向 (D)" Foreground="{Binding ForegroundHex}">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="右→左" Tag="Rtl" Click="OnDirectionMenuItemClick"/>
              <MenuItem Header="左→右" Tag="Ltr" Click="OnDirectionMenuItemClick"/>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <Button Content="{Binding ThemeText}" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="白天/夜间 (T)" Foreground="{Binding ForegroundHex}"/>
        <Button x:Name="ZoomOutButton" Content="−" Click="OnZoomOutClick" ToolTip.Tip="缩小" Foreground="{Binding ForegroundHex}"/>
        <TextBlock Text="{Binding ZoomPercentText}" VerticalAlignment="Center" Foreground="{Binding ForegroundHex}" Margin="2,0" ToolTip.Tip="当前缩放（基准=适应屏幕）"/>
        <Button x:Name="ZoomInButton" Content="＋" Click="OnZoomInClick" ToolTip.Tip="放大" Foreground="{Binding ForegroundHex}"/>
        <Button Content="{Binding FitText}" Command="{Binding CycleFitCommand}" ToolTip.Tip="切换适应模式（宽度/高度/屏幕）" Foreground="{Binding ForegroundHex}"/>
        <Button Content="复位" Click="OnResetZoomClick" ToolTip.Tip="适应宽度" Foreground="{Binding ForegroundHex}"/>
        <Button x:Name="SensitivityButton" Content="缩放×1" Click="OnSensitivityClick" ToolTip.Tip="滚轮缩放灵敏度（快/中/慢）" Foreground="{Binding ForegroundHex}"/>
        <Button x:Name="WebtoonSpeedButton" Content="滚动速度×1" Click="OnWebtoonSpeedClick" ToolTip.Tip="滚动模式滚动速度（快/中/慢）" Foreground="{Binding ForegroundHex}" IsVisible="False"/>
        <Button Content="书签" Command="{Binding ToggleBookmarkCommand}" ToolTip.Tip="当前页书签 (B)" Foreground="{Binding ForegroundHex}"/>
        <Button Content="◀书签" Command="{Binding PrevBookmarkCommand}" ToolTip.Tip="上一个书签" Foreground="{Binding ForegroundHex}"/>
        <Button Content="书签▶" Command="{Binding NextBookmarkCommand}" ToolTip.Tip="下一个书签" Foreground="{Binding ForegroundHex}"/>
      </StackPanel>
    </Border>

    <!-- 阅读区：画布模型（视口 + 图片层，Scale/Translate 变换，复刻 Windows 看图器） -->


    <!-- 底部热区（悬停唤出预览栏） -->
    <Border x:Name="BottomHotZone" DockPanel.Dock="Bottom" Height="24" Background="Transparent"
            PointerMoved="OnBottomHotZonePointerMoved" PointerExited="OnBottomHotZonePointerExited"/>
    <!-- 底部悬浮预览栏（进度条+缩略图融合 v2） -->
    <Border x:Name="PreviewStrip" DockPanel.Dock="Bottom" Height="150" Background="#E61C1C24" IsVisible="False"
            PointerMoved="OnPreviewStripPointerMoved" PointerExited="OnPreviewStripPointerExited"
            PointerWheelChanged="OnPreviewStripWheel">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Content="◀" Click="OnPreviewStripPrev" Background="Transparent" Foreground="#E8E8E8"
                FontSize="18" Width="40" VerticalAlignment="Center"/>
        <ItemsControl x:Name="ThumbStrip" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="views:ReaderWindow+ThumbStripItem">
              <Button Click="OnThumbStripItemClick" Tag="{Binding}" Background="Transparent" Padding="0" BorderThickness="0">
                <StackPanel>
                  <Border Background="#2A2A34" CornerRadius="3" ClipToBounds="True" BorderBrush="#333" BorderThickness="1">
                    <Grid>
                      <TextBlock Text="{Binding PageLabel}" Foreground="White" FontSize="10"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <Image Source="{Binding Bitmap}" Stretch="Uniform"/>
                    </Grid>
                  </Border>
                  <TextBlock Text="{Binding PageLabel}" Foreground="#CCC" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Grid.Column="2" Content="▶" Click="OnPreviewStripNext" Background="Transparent" Foreground="#E8E8E8"
                FontSize="18" Width="40" VerticalAlignment="Center"/>
      </Grid>
    </Border>
    <Border x:Name="Viewport" ClipToBounds="True" Background="{Binding BackgroundHex}"
            SizeChanged="OnViewportSizeChanged"
            PointerWheelChanged="OnPointerWheelChanged"
            PointerPressed="OnViewportPointerPressed"
            PointerMoved="OnViewportPointerMoved"
            PointerReleased="OnViewportPointerReleased"
            DoubleTapped="OnViewportDoubleTapped">
      <Grid x:Name="PageLayer" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel x:Name="PagePanel" Orientation="Horizontal" Spacing="0">
          <Image x:Name="PageImage1" Stretch="Uniform" VerticalAlignment="Top"
                 Source="{Binding Image1}"
                 IsVisible="{Binding Image1, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
          <Image x:Name="PageImage2" Stretch="Uniform" VerticalAlignment="Top"
                 Source="{Binding Image2}"
                 IsVisible="{Binding Image2, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
        </StackPanel>
      </Grid>
    </Border>
  </DockPanel>
</Window>
